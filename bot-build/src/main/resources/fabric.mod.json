{
  "schemaVersion": 1,
  "id": "botbuild",
  "version": "${version}",
  "name": "Bot Build",
  "description": "Outline a build with the Build Wand. Ghost blocks show the plan, then a bot ferries the real blocks from a nearby chest or your inventory and places them one by one.",
  "authors": [
    "felix"
  ],
  "license": "MIT",
  "environment": "*",
  "icon": "assets/botbuild/icon.png",
  "entrypoints": {
    "main": [
      "dev.explorercraft.botbuild.BotBuild"
    ],
    "fabric-gametest": [
      "dev.explorercraft.botbuild.BotBuildGameTest"
    ]
  },
  "mixins": [
    "botbuild.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
