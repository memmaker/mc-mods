{
  "schemaVersion": 1,
  "id": "whiteflag",
  "version": "${version}",
  "name": "White Flag",
  "description": "Craft a white flag. Carry it in your hotbar and every hostile mob stops attacking you.",
  "authors": [
    "felix"
  ],
  "license": "MIT",
  "icon": "assets/whiteflag/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.explorercraft.whiteflag.WhiteFlag"
    ],
    "fabric-gametest": [
      "dev.explorercraft.whiteflag.WhiteFlagGameTest"
    ]
  },
  "mixins": [
    "whiteflag.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
