{
  "schemaVersion": 1,
  "id": "lift",
  "version": "${version}",
  "name": "Lift",
  "description": "Craft a Lift Plate from any pressure plate and redstone. Step on it to rise, until a ceiling or the height of the walls beside it stops you.",
  "authors": [
    "felix"
  ],
  "license": "MIT",
  "icon": "assets/lift/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.explorercraft.lift.Lift"
    ],
    "fabric-gametest": [
      "dev.explorercraft.lift.LiftGameTest"
    ],
    "client": [
      "dev.explorercraft.lift.client.LiftClient"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
