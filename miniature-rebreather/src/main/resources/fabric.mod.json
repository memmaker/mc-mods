  "authors": ["felix"],
  "license": "MIT",
  "icon": "assets/rebreather/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.explorercraft.rebreather.Rebreather"],
    "fabric-gametest": ["dev.explorercraft.rebreather.RebreatherGameTest"]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
